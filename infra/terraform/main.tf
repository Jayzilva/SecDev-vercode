# WARNING: intentionally insecure Terraform for IaC-scanner training.
# This is NEVER applied: no backend, no credentials, no `terraform apply` anywhere in CI.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

# POC-VULN: public-read bucket, no encryption, no versioning, no logging
resource "aws_s3_bucket" "uploads" {
  bucket = "vulnapp-poc-uploads"
}

resource "aws_s3_bucket_acl" "uploads" {
  bucket = aws_s3_bucket.uploads.id
  acl    = "public-read"
}

resource "aws_s3_bucket_public_access_block" "uploads" {
  bucket                  = aws_s3_bucket.uploads.id
  block_public_acls       = false
  block_public_policy     = false
  ignore_public_acls      = false
  restrict_public_buckets = false
}

# POC-VULN: SSH and app port open to the whole internet
resource "aws_security_group" "web" {
  name        = "vulnapp-web"
  description = "VulnApp web"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# POC-VULN: unencrypted, publicly accessible database with hard-coded password
resource "aws_db_instance" "main" {
  identifier          = "vulnapp-db"
  engine              = "postgres"
  instance_class      = "db.t3.micro"
  allocated_storage   = 20
  username            = "admin"
  password            = "SuperSecret123!"
  publicly_accessible = true
  storage_encrypted   = false
  skip_final_snapshot = true
}
