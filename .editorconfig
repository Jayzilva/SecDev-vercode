root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,tf}]
indent_size = 2

# -----------------------------------------------------------------------------
# Roslyn security analyzers (built into the .NET SDK, Microsoft.CodeAnalysis.NetAnalyzers).
# Most taint-analysis rules (CA3xxx) are OFF by default — turn them on so the
# compiler itself becomes a lightweight SAST tool. Output goes to SARIF in CI.
# -----------------------------------------------------------------------------
[*.cs]
dotnet_diagnostic.CA2100.severity = warning   # SQL built from user input
dotnet_diagnostic.CA2326.severity = warning   # TypeNameHandling other than None
dotnet_diagnostic.CA2327.severity = warning   # Insecure JsonSerializerSettings
dotnet_diagnostic.CA2328.severity = warning
dotnet_diagnostic.CA2329.severity = warning   # Insecure JsonSerializer config
dotnet_diagnostic.CA2330.severity = warning
dotnet_diagnostic.CA3001.severity = warning   # SQL injection (taint)
dotnet_diagnostic.CA3002.severity = warning   # XSS (taint)
dotnet_diagnostic.CA3003.severity = warning   # File path injection (taint)
dotnet_diagnostic.CA3004.severity = warning   # Information disclosure
dotnet_diagnostic.CA3006.severity = warning   # Process command injection (taint)
dotnet_diagnostic.CA3007.severity = warning   # Open redirect (taint)
dotnet_diagnostic.CA3011.severity = warning   # DLL injection
dotnet_diagnostic.CA3012.severity = warning   # Regex injection
dotnet_diagnostic.CA5350.severity = warning   # Weak crypto (SHA1/TripleDES)
dotnet_diagnostic.CA5351.severity = warning   # Broken crypto (MD5/DES)
dotnet_diagnostic.CA5359.severity = warning   # Disabled certificate validation
dotnet_diagnostic.CA5394.severity = warning   # Insecure randomness
