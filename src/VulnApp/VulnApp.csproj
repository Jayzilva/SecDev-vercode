<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    WARNING: Intentionally vulnerable application for security-scanner training.
    Do NOT deploy. Do NOT reuse this code.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Veracode static analysis needs debug symbols (PDB) alongside the DLLs. -->
    <DebugType>portable</DebugType>
    <!-- Roslyn security analyzers (CA2100, CA3xxx, CA5xxx) are enabled in ../../.editorconfig -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Keep NuGet vulnerability audit on (reports NU1901-NU1904) but do not fail the build: POC needs it to compile. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Commit packages.lock.json: reproducible restores, and SCA tools (Trivy) read it without a build. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- POC-VULN: CWE-1104 — Newtonsoft.Json < 13.0.1 (GHSA-5crp-9r3c-p9vr, CVE-2024-21907) -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
    <!-- POC-VULN: CWE-1104 — System.Text.RegularExpressions 4.3.0 (CVE-2019-0820, ReDoS) -->
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.0" />
  </ItemGroup>

</Project>
